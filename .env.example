# 1. Supabase Free Tier Credentials (from Supabase Dashboard -> Settings -> API)
# PUBLIC URL (safe for frontend)
SUPABASE_URL=https://your-project-id.supabase.co

# PUBLIC ANONYMOUS KEY (safe for frontend with Row Level Security)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ⚠️ NEVER expose the service_role key on the client or in GitHub repositories!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-only-for-backend-scripts

# 2. Google Analytics 4 (Free Tier)
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# 3. Optional Free Tier AI Key (e.g., Google AI Studio Gemini API Free Tier)
# Leave blank to use the built-in 100% offline Rule-Based AI Engine
GEMINI_FREE_API_KEY=
